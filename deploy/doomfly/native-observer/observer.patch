+// DOOMFLY private observer protocol. Enabled only by a process-local output path.
+// Called while VIZ_MQTic waits: no ticker, action, save/load or RNG is invoked here.
+#include <vector>
+#include <sstream>
+#include <cmath>
+#include "r_state.h"
+#include "r_data/sprites.h"
+#include "textures/textures.h"
+#include "viz_depth.h"
+#include "d_player.h"
+
+bool doomflyObserverActive = false;
+double doomflyObserverPose[5] = {0, 0, 41, 0, 0};
+extern fixed_t viewx, viewy, FocalLengthX, FocalLengthY, centerxfrac, centeryfrac;
+extern int viewpitch, viewwindowx, viewwindowy;
+
+CCMD(doomfly_view)
+{
+    const char *output = getenv("DOOMFLY_OBSERVER_OUTPUT");
+    if (!output || !*output || argv.argc() != 7 || !screen || *viz_screen_format != VIZ_SCREEN_RGB24) return;
+    char *end = NULL;
+    unsigned long nonce = strtoul(argv[1], &end, 10);
+    if (!end || *end || !nonce || nonce > 2147483647UL) return;
+    for (int i=0; i<5; ++i) {
+        doomflyObserverPose[i] = strtod(argv[i+2], &end);
+        if (!end || *end || !std::isfinite(doomflyObserverPose[i])) return;
+    }
+    if (fabs(doomflyObserverPose[0]) > 8192 || fabs(doomflyObserverPose[1]) > 8192 ||
+        fabs(doomflyObserverPose[2]) > 2048 || doomflyObserverPose[3] < 0 ||
+        doomflyObserverPose[3] >= 360 || fabs(doomflyObserverPose[4]) > 60) return;
+    bool weapon = r_drawplayersprites;
+    r_drawplayersprites = false;
+    doomflyObserverActive = true;
+    VIZ_D_ScreenDisplay();
+    std::vector<BYTE> rgb(vizScreenSize), depth(vizScreenChannelSize, 255), spritesRGBA;
+    screen->Lock(true);
+    VIZ_CopyBuffer(rgb.data());
+    if (vizDepthMap) memcpy(depth.data(), vizDepthMap->getBuffer(), depth.size());
+    PalEntry *palette = screen->GetPalette();
+    std::ostringstream header;
+    header << "{\"version\":1,\"nonce\":" << nonce << ",\"width\":" << vizScreenWidth
+           << ",\"height\":" << vizScreenHeight << ",\"camera\":[" << double(viewx)/FRACUNIT << ","
+           << double(viewy)/FRACUNIT << "," << double(viewz)/FRACUNIT << "," << double(viewangle)*(360.0/4294967296.0)
+           << "," << double(viewpitch)*(360.0/4294967296.0) << "],\"projection\":["
+           << double(FocalLengthX)/FRACUNIT << "," << double(FocalLengthY)/FRACUNIT << ","
+           << double(centerxfrac)/FRACUNIT+viewwindowx << "," << double(centeryfrac)/FRACUNIT+viewwindowy << "],\"weapon\":[";
+    player_t *player = players[consoleplayer].mo ? &players[consoleplayer] : NULL;
+    bool comma = false;
+    if (player) for (int layer=ps_weapon; layer<=ps_flash; ++layer) {
+        pspdef_t *psp = &player->psprites[layer];
+        if (!psp->state || (unsigned)psp->sprite >= sprites.Size()) continue;
+        spritedef_t &sprite = sprites[psp->sprite];
+        if ((unsigned)psp->frame >= sprite.numframes) continue;
+        spriteframe_t &frame = SpriteFrames[sprite.spriteframes+psp->frame];
+        FTexture *tex = TexMan(frame.Texture[0]);
+        if (!tex || tex->UseType == FTexture::TEX_Null) continue;
+        int w=tex->GetWidth(), h=tex->GetHeight();
+        if (w<=0 || h<=0 || w>512 || h>512) continue;
+        if (comma) header << ",";
+        comma = true;
+        header << "{\"layer\":" << layer << ",\"sprite\":" << psp->sprite << ",\"frame\":" << psp->frame
+               << ",\"tics\":" << psp->tics << ",\"width\":" << w << ",\"height\":" << h
+               << ",\"left\":" << tex->LeftOffset << ",\"top\":" << tex->TopOffset
+               << ",\"sx\":" << double(psp->sx)/FRACUNIT << ",\"sy\":" << double(psp->sy)/FRACUNIT
+               << ",\"flip\":" << (frame.Flip&1) << "}";
+        const BYTE *pixels = tex->GetPixels();
+        for (int y=0; y<h; ++y) for (int x=0; x<w; ++x) {
+            BYTE c = pixels[x*h+y];
+            spritesRGBA.push_back(palette[c].r); spritesRGBA.push_back(palette[c].g);
+            spritesRGBA.push_back(palette[c].b); spritesRGBA.push_back(c ? 255 : 0);
+        }
+    }
+    header << "]}";
+    screen->Unlock();
+    doomflyObserverActive = false;
+    // Restore view/projection, keeping psprites suppressed. P_BobWeapon mutates
+    // a static smoothing accumulator every render, even without a game tic.
+    // Only the next ordinary action update may render/advance that accumulator.
+    // The published shared-memory RGB remains the original first-person frame.
+    VIZ_D_ScreenDisplay();
+    r_drawplayersprites = weapon;
+    std::string temporary = std::string(output)+".tmp", metadata = header.str();
+    FILE *f = fopen(temporary.c_str(), "wb");
+    if (!f) return;
+    unsigned int length = (unsigned int)metadata.size();
+    fwrite("DFVIEW01", 1, 8, f); fwrite(&length, 4, 1, f);
+    fwrite(metadata.data(), 1, length, f); fwrite(rgb.data(), 1, rgb.size(), f);
+    fwrite(depth.data(), 1, depth.size(), f); fwrite(spritesRGBA.data(), 1, spritesRGBA.size(), f);
+    if (fclose(f)==0) rename(temporary.c_str(), output);
+}
